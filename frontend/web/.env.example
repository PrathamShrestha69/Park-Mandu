# Server-only: base URL of the Park Mandu FastAPI backend (never exposed to the browser)
API_URL=http://localhost:8000/api/v1

# Set to true behind HTTPS so session cookies get the Secure flag
COOKIE_SECURE=false

# Development only: show one-click demo accounts on the sign-in page
DEMO_LOGIN=true

# Public map style (MapLibre / OpenFreeMap)
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
