# Park Mandu API (FastAPI). Leave unset in development: the app uses the machine running `expo start`
# on port 8000, so a phone on the same Wi-Fi reaches the Docker API automatically.
# EXPO_PUBLIC_API_URL=https://api.parkmandu.example/api/v1

# Map style (OpenFreeMap vector tiles)
# EXPO_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
