# ---------------------------------------------------------------------------
# Park Mandu — environment configuration
# Copy to `.env` and change every secret before deploying anywhere public.
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# PostgreSQL (PostGIS) — used by docker compose and the API/worker
POSTGRES_USER=parkmandu
POSTGRES_PASSWORD=parkmandu_dev_password
POSTGRES_DB=parkmandu

# Signing key for access tokens (generate: python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me-to-a-long-random-string
# Fernet key for encrypting government ID numbers at rest
# (generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=change-me-fernet-key
# Shared secret used by CCTV / AI detection systems calling POST /api/v1/ingest/detections
INGEST_API_KEY=change-me-ingest-key

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# Cookies (set COOKIE_SECURE=true behind HTTPS; COOKIE_DOMAIN e.g. .parkmandu.gov.np)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Comma separated list of browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Background simulation of CCTV telemetry and illegal-parking detections (demo data)
SIMULATE_DETECTIONS=true

# Development only: return OTP / password-reset codes in API responses instead of SMS/email
EXPOSE_DEV_CODES=true

# Expo push notifications for the mobile app
EXPO_PUSH_ENABLED=false
