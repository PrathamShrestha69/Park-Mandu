# ---------------------------------------------------------------------------
# Park Mandu — environment configuration
# Copy to `.env` and change every secret before deploying anywhere public.
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# PostgreSQL (PostGIS) — used by docker compose and the API/worker
POSTGRES_USER=parkmandu
POSTGRES_PASSWORD=parkmandu_dev_password
POSTGRES_DB=parkmandu

# Signing key for access tokens (generate: python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me-to-a-long-random-string
# Fernet key for encrypting government ID numbers at rest
# (generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=change-me-fernet-key
# Shared secret used by CCTV / AI detection systems calling POST /api/v1/ingest/detections
INGEST_API_KEY=change-me-ingest-key

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# Cookies (set COOKIE_SECURE=true behind HTTPS; COOKIE_DOMAIN e.g. .parkmandu.gov.np)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Comma separated list of browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Background simulation of CCTV telemetry and illegal-parking detections (demo data)
SIMULATE_DETECTIONS=true

# Development only: return OTP / password-reset codes in API responses instead of SMS/email
EXPOSE_DEV_CODES=true

# Expo push notifications for the mobile app
EXPO_PUSH_ENABLED=false

# Nearest-officer dispatch: radius in metres, and how fresh an officer's reported position must be
DISPATCH_RADIUS_M=1000
OFFICER_LOCATION_TTL_SECONDS=600
# After one "no officer within 1 km" notice for a camera, more notices for it are muted this long (15 min)
NO_OFFICER_NOTICE_MUTE_SECONDS=900
# Parking shows "Partially available" once this share (or less) of its spaces is free
PARKING_PARTIAL_THRESHOLD=0.5
# Consecutive identical AI camera reports needed before parking availability changes
OCCUPANCY_CONFIRMATIONS=3

# ---------------------------------------------------------------------------
# Traffic-aware illegal-parking alerts (Parking Availability Bridge)
# ---------------------------------------------------------------------------
# Traffic measurements older than this count as "unknown" (parking alerts still go out)
TRAFFIC_STATUS_MAX_AGE_SECONDS=120
# Traffic levels treated as a jam: the only condition that holds parking alerts back
TRAFFIC_JAM_LEVELS=congested
# A parked vehicle the bridge stops reporting for this long is no longer observed
PARKING_STATUS_STALE_SECONDS=60

# ---------------------------------------------------------------------------
# Paid parking: eSewa and Khalti. Keep these on the server only; never put them in the apps.
# ---------------------------------------------------------------------------
PAYMENTS_ENABLED=true
BOOKING_HOLD_MINUTES=15
BOOKING_MAX_HOURS=12
BOOKING_ARRIVAL_WINDOW_MINUTES=20
# Public address of this API that eSewa/Khalti send drivers back to (must be reachable from their phone).
# Leave empty in development: the address the app used to reach the API is used.
PAYMENT_CALLBACK_BASE_URL=
# Where drivers may be returned after paying: the web app origin(s) and the mobile app URL schemes
PAYMENT_RETURN_ORIGINS=http://localhost:3000
PAYMENT_RETURN_SCHEMES=parkmandu,exp,exps
WEB_APP_URL=http://localhost:3000

# eSewa ePay v2. Sandbox values below are eSewa's published test merchant (EPAYTEST).
# Production: set ESEWA_ENVIRONMENT=production and your own merchant code and secret key.
ESEWA_ENVIRONMENT=sandbox
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# Khalti ePayment. Get a sandbox "live secret key" from https://test-admin.khalti.com (Keys menu).
# Khalti stays switched off until a key is set.
KHALTI_ENVIRONMENT=sandbox
KHALTI_SECRET_KEY=

# ---------------------------------------------------------------------------
# In-app navigation: OSRM-compatible routing service
# ---------------------------------------------------------------------------
# The public OSRM demo server is fine for development; run your own OSRM (or a hosted one) in production.
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_PROFILE=driving
